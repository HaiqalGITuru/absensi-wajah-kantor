# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK BOLEH dimasukkan ke Git.

# development | production | testing
APP_ENV=development

# Buat string acak dengan perintah:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-hasil-perintah-di-atas

# Koneksi MySQL / MariaDB (XAMPP atau Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=absensi_wajah
DB_USER=absensi_app
DB_PASSWORD=ganti-dengan-password-user-database

# Zona waktu kantor (Tabalong, Kalimantan Selatan = WITA)
OFFICE_TIMEZONE=Asia/Makassar

# Lokasi file kunci enkripsi templat wajah.
# WAJIB di luar folder proyek agar tidak ikut ke Git atau tersalin bersama kode.
# Buat filenya dengan: flask --app app biometric-keygen
BIOMETRIC_KEY_FILE=D:\absensi-secrets\biometric_keys.json

# Kamera (Tahap 3). Lihat daftar kamera dengan: flask --app app camera-scan
# CAMERA_NAME memilih kamera berdasarkan nama (disarankan), CAMERA_INDEX
# hanya dipakai jika nama tidak dapat dibaca.
CAMERA_NAME=C270
CAMERA_INDEX=0
CAMERA_BACKEND=dshow
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
