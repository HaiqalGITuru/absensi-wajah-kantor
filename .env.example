# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK BOLEH dimasukkan ke Git.

# development | production | testing
APP_ENV=development

# Buat string acak dengan perintah:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-hasil-perintah-di-atas

# Koneksi MySQL / MariaDB (XAMPP atau Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=absensi_wajah
DB_USER=absensi_app
DB_PASSWORD=ganti-dengan-password-user-database

# Zona waktu kantor (Tabalong, Kalimantan Selatan = WITA)
OFFICE_TIMEZONE=Asia/Makassar
