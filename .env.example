# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK BOLEH dimasukkan ke Git.

# development | production | testing
APP_ENV=development

# Buat string acak dengan perintah:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-hasil-perintah-di-atas

# Koneksi MySQL / MariaDB (XAMPP atau Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=absensi_wajah
DB_USER=absensi_app
DB_PASSWORD=ganti-dengan-password-user-database

# Zona waktu kantor (Tabalong, Kalimantan Selatan = WITA)
OFFICE_TIMEZONE=Asia/Makassar

# Lokasi file kunci enkripsi templat wajah.
# WAJIB di luar folder proyek agar tidak ikut ke Git atau tersalin bersama kode.
# Buat filenya dengan: flask --app app biometric-keygen
BIOMETRIC_KEY_FILE=D:\absensi-secrets\biometric_keys.json

# Kamera (Tahap 3). Lihat daftar kamera dengan: flask --app app camera-scan
# CAMERA_NAME memilih kamera berdasarkan nama (disarankan), CAMERA_INDEX
# hanya dipakai jika nama tidak dapat dibaca.
CAMERA_NAME=C270
CAMERA_INDEX=0
CAMERA_BACKEND=dshow
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# Model AI (Tahap 3B). Unduh dengan: flask --app app models-download
# MODEL_DIR boleh dikosongkan (bawaan: folder model_files di proyek).
FACE_DETECT_WIDTH=640
FACE_MIN_SCORE=0.85
FACE_MIN_SIZE=80
FACE_MIN_SHARPNESS=40

# Pencocokan dan pelacakan (Tahap 3C). Nilai SEMENTARA, kalibrasi di lokasi.
FACE_MATCH_THRESHOLD=0.363
FACE_MATCH_MARGIN=0.05
TRACK_WINDOW=5
TRACK_CONFIRM_VOTES=3
IDENTITY_COOLDOWN_SECONDS=30

# Aturan absensi (Tahap 4A)
# Check-in dibuka sekian menit sebelum jam masuk jadwal.
CHECKIN_EARLY_MINUTES=120
# Check-out baru diterima setelah sekian menit sejak check-in.
CHECKOUT_MIN_MINUTES=240
# Batas check-out setelah jam pulang jadwal (jam).
CHECKOUT_GRACE_HOURS=6
# true = jam pulang mengikuti lintasan terakhir; false = lintasan pertama.
CHECKOUT_UPDATE_LATER=true
